# Project ORION (S.T.A.R.K. MVP) - WhatsApp Intelligence Report Compiler

# OpenRouter Multimodal Vision-Language Model
OPENROUTER_API_KEY="your-openrouter-api-key-here"
OPENROUTER_MODEL="nvidia/nemotron-3.5-super-vl:free"
OPENROUTER_TEMPERATURE=0.0

# Backend Server
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8765

# WhatsApp Automation & Stage-Safe Demo Mode
WHATSAPP_SESSION_DIR="./whatsapp_session"
WHATSAPP_TIMEOUT_SECONDS=15
DEMO_FALLBACK_MODE=true
REPORTS_DIR="./reports"

# J.A.R.V.I.S. Neural Butler Voice Engine
ORION_VOICE_ENABLED=true
ORION_TTS_VOICE="en-GB-RyanNeural"
ORION_TTS_RATE="+6%"
ORION_TTS_PITCH="-4Hz"
ORION_USER_TITLE="Sir"

# Hotkey Configuration (Alt+Space to speak)
ORION_HOTKEY="alt+space"
